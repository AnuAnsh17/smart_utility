# ---------------------------------------------------------------------------
# Smart Utility backend configuration
# Copy to backend/.env and adjust. Everything stays local by default.
# ---------------------------------------------------------------------------

APP_NAME="Smart Utility Backend"
HOST=127.0.0.1
PORT=8000

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where uploaded documents, derived artefacts, results and the database live.
# Relative paths resolve against the backend/ directory.
DATA_DIR=./data

# --- upload limits ---------------------------------------------------------
MAX_UPLOAD_BYTES=10485760

# --- OCR -------------------------------------------------------------------
# Only `tesseract` is implemented. Adding another engine means adding a class
# in app/services/ocr_service.py and extending the factory.
OCR_ENGINE=tesseract
# Tesseract language packs, tried together. Must be installed on the system:
#   tesseract --list-langs
OCR_LANGUAGES=eng,hin,mar
# Rasterisation DPI for PDFs. Higher = more accurate, slower.
OCR_DPI=300
# Refuse to OCR documents longer than this.
OCR_MAX_PAGES=12
# Per-document OCR budget.
OCR_TIMEOUT_SECONDS=180
# Persist the rasterised page images under data/processed/<job_id>/. They are
# derived copies of the user's document — keep this off unless you need to
# inspect OCR quality.
OCR_KEEP_PAGE_IMAGES=false

# --- language --------------------------------------------------------------
# Script detection is always on. Translation of non-English bill text into
# English field labels is a normalisation aid, never a source of values.
ENABLE_TRANSLATION=false

# --- agent (LLM) integration ----------------------------------------------
# The agent is an OPTIONAL assistant used only to disambiguate fields the
# deterministic rules could not resolve. When disabled or unavailable the
# pipeline runs rules-only and simply leaves those fields null.
AGENT_ENABLED=false
# Absolute path to an allowlisted agent CLI. Leave blank to auto-detect
# from the built-in allowlist (claude, codex).
AGENT_CLI_PATH=
# Hard wall-clock limit for a single agent invocation.
AGENT_TIMEOUT_SECONDS=90
# Tools the agent is permitted to use. Empty string = no tools at all, which
# is the safe default: the agent then cannot touch the filesystem or shell.
AGENT_ALLOWED_TOOLS=
# Working directory for agent invocations, relative to DATA_DIR. The agent is
# sandboxed here and never runs inside the project tree.
AGENT_SANDBOX_DIR=agent_sandbox
# Environment variables forwarded to the agent process. Everything else is
# dropped and HOME is redirected into the sandbox, so nothing ambient leaks in.
# If your agent CLI authenticates with an env var, name that variable here.
AGENT_ENV_ALLOWLIST=

# --- weather (optional external enrichment) --------------------------------
# When disabled, or when the network is unreachable, analysis still completes
# and the dashboard shows weather_status="unavailable".
WEATHER_ENABLED=false
WEATHER_API_BASE=https://api.open-meteo.com/v1
WEATHER_TIMEOUT_SECONDS=6

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# Redact consumer numbers, addresses, phone numbers and OCR text from logs.
LOG_REDACT=true
LOG_DIR=./data/logs
